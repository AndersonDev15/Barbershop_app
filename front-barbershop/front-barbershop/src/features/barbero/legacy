      id="toast"
    >
      <span
        class="material-symbols-outlined"
        data-icon="check_circle"
        style="font-variation-settings: &quot;FILL&quot; 1"
        >check_circle</span
      >
      <span id="toast-message">Appointment started successfully</span>
    </div>
    <script>
      const todayStr = "2024-10-24";
      const datePicker = document.getElementById("appointment-date-picker");
      const viewTitle = document.getElementById("view-title");
      const viewSubtitle = document.getElementById("view-subtitle");

      function formatDateDisplay(dateStr) {
        const options = {
          weekday: "long",
          year: "numeric",
          month: "long",
          day: "numeric",
        };
        const date = new Date(dateStr + "T00:00:00");
        return date.toLocaleDateString("en-US", options);
      }

      function handleDateChange(newDate) {
        if (newDate === todayStr) {
          viewTitle.textContent = "Today's Appointments";
        } else {
          const formattedDate = new Date(
            newDate + "T00:00:00",
          ).toLocaleDateString("en-US", { month: "short", day: "numeric" });
          viewTitle.textContent = `Appointments - ${formattedDate}`;
        }
        viewSubtitle.textContent = formatDateDisplay(newDate);

        // Visual feedback for "loading" new data
        const list = document.getElementById("appointments-list");
        list.style.opacity = "0.5";
        setTimeout(() => {
          list.style.opacity = "1";
        }, 300);
      }

      function navigateDate(days) {
        const currentDate = new Date(datePicker.value + "T00:00:00");
        currentDate.setDate(currentDate.getDate() + days);
        const nextDateStr = currentDate.toISOString().split("T")[0];
        datePicker.value = nextDateStr;
        handleDateChange(nextDateStr);
      }

      function setToday() {
        datePicker.value = todayStr;
        handleDateChange(todayStr);
      }

      function toggleDropdown(button) {
        // Close all other dropdowns
        document.querySelectorAll(".appointment-dropdown").forEach((d) => {
          if (d !== button.nextElementSibling) d.classList.remove("show");
        });
        button.nextElementSibling.classList.toggle("show");
      }

      // Close dropdowns on outside click
      window.onclick = function (event) {
        if (!event.target.closest(".dropdown-container")) {
          document
            .querySelectorAll(".appointment-dropdown")
            .forEach((d) => d.classList.remove("show"));
        }
      };

      function showToast(message) {
        const toast = document.getElementById("toast");
        const msg = document.getElementById("toast-message");
        msg.textContent = message;
        toast.classList.add("show");
        setTimeout(() => toast.classList.remove("show"), 3000);
      }

      function updateStatus(option, status) {
        const card = option.closest(".appointment-card");
        const badge = card.querySelector(".status-badge");
        const dropdown = option.parentElement;

        dropdown.classList.remove("show");

        if (status === "In Progress") {
          badge.className =
            "status-badge flex items-center gap-2 px-4 py-2 rounded-full bg-tertiary/10 border border-tertiary/20";
          badge.innerHTML = `<span class="w-2 h-2 rounded-full bg-tertiary animate-pulse"></span><span class="text-tertiary text-xs font-bold uppercase tracking-widest">In Progress</span>`;
          card.classList.remove("opacity-70", "bg-surface-container-lowest");
          card.classList.add("bg-surface-container-high");
          showToast("Appointment started");
        } else if (status === "Completed") {
          badge.className =
            "status-badge flex items-center gap-2 px-4 py-2 rounded-full bg-primary/10 border border-primary/20";
          badge.innerHTML = `<span class="material-symbols-outlined text-primary text-xs" data-icon="check_circle" style="font-variation-settings: 'FILL' 1;">check_circle</span><span class="text-primary text-xs font-bold uppercase tracking-widest">Completed</span>`;
          card.classList.add("opacity-70", "bg-surface-container-lowest");
          card.querySelector("h3").classList.add("line-through");
          showToast("Appointment completed");
        }
      }
    </script>
  </body>
</html>
